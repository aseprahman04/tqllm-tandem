+// Experimental Inkling gate/up fusion. Ingine groups both projections for the
+// same feature tile and applies softcapped SwiGLU at the producer. This version
+// retains the Basalt pack's independent matrices, q8_1 input and dot order.
+template<int NC, bool Exact>
+__device__ __forceinline__ void paired_gate_up_features(
+        const uint8_t* blob, const block_q8_1* xq, NativeExpertLayout layout,
+        const int32_t* ent_tok, int entry, int n, int tile, float (&hidden)[GRP_NC][32]) {
+    constexpr int kWarpCount = 8;
+    constexpr int kDotCalls = 144;
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    int offset[NC];
+#pragma unroll
+    for (int c = 0; c < NC; ++c) offset[c] = ent_tok[entry + min(c, n - 1)] * (2304 / 32);
+    const float gate_scale = nvfp4_tail(blob, layout)[0];
+    const float up_scale = nvfp4_tail(blob, layout)[1];
+    for (int col = warp; col < 32; col += kWarpCount) {
+        const auto* gate_row = blob + (size_t)(tile + col) * layout.gu_row;
+        float gate[NC], up[NC];
+        row_dot_multi<40, NC, Exact, false, kDotCalls>(gate_row, xq, offset, n, 2304 / 64, lane, gate);
+        row_dot_multi<40, NC, Exact, false, kDotCalls>(gate_row + layout.up_off, xq, offset, n, 2304 / 64, lane, up);
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            if (lane == c && (Exact || c < n)) {
+                const float g = gate[c] * gate_scale;
+                const float u = up[c] * up_scale;
+                hidden[c][col] = __fmul_rn(__fmul_rn(layout.gate_softcap * tanhf(g / layout.gate_softcap),
+                                                     1.f / (1.f + expf(-g))), layout.up_softcap * tanhf(u / layout.up_softcap));
+            }
+        }
+    }
+}
+
+__global__ void __launch_bounds__(256) inkling_paired_gate_up_q8_kernel(
+        const unsigned long long* grp_ptr, const int32_t* grp_start, const int32_t* n_groups,
+        const int32_t* ent_tok, const block_q8_1* xq, NativeExpertLayout layout, block_q8_1* hq) {
+    const int groups = *n_groups;
+    if (groups <= (int)gridDim.y) pdl_launch_dependents();
+    if (blockIdx.y >= groups) return;
+    __shared__ float hidden[GRP_NC][32];
+    const int tile = (int)blockIdx.x * 32;
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    for (int group = blockIdx.y; group < groups; group += gridDim.y) {
+        const auto* blob = reinterpret_cast<const uint8_t*>(grp_ptr[group]);
+        const int end = grp_start[group + 1];
+        for (int entry = grp_start[group]; entry < end; entry += GRP_NC) {
+            const int n = min(GRP_NC, end - entry);
+            if (n == 1) paired_gate_up_features<1,true>(blob,xq,layout,ent_tok,entry,n,tile,hidden);
+            else if (n == 2) paired_gate_up_features<2,true>(blob,xq,layout,ent_tok,entry,n,tile,hidden);
+            else paired_gate_up_features<GRP_NC,false>(blob,xq,layout,ent_tok,entry,n,tile,hidden);
+            __syncthreads();
+            if (warp < n) {
+                const long long i = (long long)(entry + warp) * layout.n_ff + tile + lane;
+                q8_1_store(hidden[warp][lane], hq, i);
+            }
+            __syncthreads();
+        }
+    }
+}
